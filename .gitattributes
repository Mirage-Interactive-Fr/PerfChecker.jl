* text=auto
/.gitattributes text eol=lf

*.jl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.svg text eol=lf
# Plot exporters split SVG path data across lines with trailing separators.
*.svg whitespace=-blank-at-eol
# Preserve exact third-party runtime bundles and native Markdown hard breaks.
website/src/public/examples/plot-assets/bonito/js/*.js whitespace=-blank-at-eof
website/src/public/examples/tool-recipes/recorded-performance.md whitespace=-blank-at-eol

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.vsix binary
